PORT=3000
NODE_ENV=development

# MySQL / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_app
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Set each secret to a long random value before running
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_refresh_secret
OTP_HASH_SECRET=replace_with_a_long_random_otp_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="Social App <your-email@gmail.com>"

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
FRONTEND_URL=http://localhost:5173
